NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=proprietaire@example.com

# WebRTC TURN (recommended in production)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/espace?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/espace?payment=cancelled

# PayPal Checkout — use sandbox while developing
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
PAYPAL_RETURN_URL=http://localhost:3000/espace?paypal=success
PAYPAL_CANCEL_URL=http://localhost:3000/espace?paypal=cancelled
