NODE_ENV=development
PORT=3000

# OBLIGATOIRE en production : chaîne aléatoire d'au moins 32 caractères.
SESSION_SECRET=change-me-with-a-long-random-secret-at-least-32-characters

# L'adresse ci-dessous devient automatiquement le compte propriétaire.
ADMIN_EMAIL=proprietaire@example.com

# Optionnel mais fortement recommandé en production pour WebRTC derrière NAT/4G/5G.
# Exemple : turn:turn.votredomaine.fr:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
